<!doctype html><html lang="fr"><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Nouvel arrivage · Atelier de prise</title><style>
*{box-sizing:border-box}html{background:#f6f2e9;color:#272519;font:16px/1.48 system-ui,sans-serif}body{margin:0}.mast{padding:15px max(4vw,calc((100vw - 1080px)/2));background:#263d33;color:white;display:flex;align-items:center;gap:12px;white-space:nowrap;font-weight:750}.mark{display:inline-block;border:2px solid #f2b869;padding:1px 8px;border-radius:7px;color:#f2b869}.wrap{max-width:1110px;margin:auto;padding:26px 20px 60px}.k{font-size:.72rem;letter-spacing:.15em;text-transform:uppercase;font-weight:800;color:#745333}h1,h2,h3,p{margin:0}h1,h2{font-family:Georgia,serif;line-height:1.05;letter-spacing:-.035em}h1{font-size:clamp(34px,5vw,62px);margin:8px 0 10px}h2{font-size:clamp(25px,3.2vw,40px);margin:8px 0 16px}h3{font-size:1rem}.muted,small{color:#555d51}.layout{display:grid;grid-template-columns:minmax(0,1fr) 245px;gap:16px;margin-top:22px}article,aside{background:#fffcf5;border:1px solid #d9d4c6;border-radius:18px;padding:clamp(16px,3vw,30px)}aside{align-self:start;padding:20px}.fields,.pair{display:grid;grid-template-columns:1fr 1fr;gap:14px}.fields label{font-size:.92rem;font-weight:650;display:block}input{font:inherit;width:100%;padding:11px;border:1px solid #a9aa9c;border-radius:7px;background:white;color:inherit;margin-top:5px}input::placeholder{color:#72776d;font-weight:400}button{font:inherit;cursor:pointer;border:1px solid #a7ada3;border-radius:8px;background:white;color:#233b30;padding:8px 12px;font-weight:650}button:hover,button:focus-visible{outline:2px solid #b78043;outline-offset:1px}button.active,.primary{background:#254438;color:white;border-color:#254438}button:disabled{opacity:.52;cursor:not-allowed}.actions{display:flex;flex-wrap:wrap;gap:8px;margin-top:16px}.note{margin:14px 0;padding:10px 13px;background:#efefe2;border-left:3px solid #998454;font-size:.86rem}.navrow{border-top:1px solid #ddd8ca;margin-top:12px;padding-top:10px}.navrow button{margin:6px 4px 0 0;font-size:.82rem;min-width:42px}.navrow small{display:block}.badge{display:inline-block;background:#efdfbd;border-radius:50px;padding:3px 11px;font-size:.77rem;font-weight:bold}.box{padding:12px;background:#f0eedf;border-radius:9px;margin:10px 0}.box p{margin-top:4px}.pair .box:nth-child(2){background:#f6e8df}.player{overflow:hidden;position:relative;background:#d7b88c;border-radius:12px;height:clamp(155px,30vh,260px);margin:12px 0;display:grid;place-items:center}.player svg,.player video{width:100%;height:100%;object-fit:contain}.stamp,.clock{position:absolute;top:10px;background:#24372de0;color:white;border-radius:6px;padding:3px 8px;font-variant-numeric:tabular-nums}.stamp{left:10px}.clock{right:10px}progress{width:100%;accent-color:#327452}.stage{margin-bottom:10px}ul{margin:5px 0;padding-left:20px}.inline{width:auto;margin-right:6px}button,input{touch-action:manipulation}@media(max-width:750px){.layout{display:flex;flex-direction:column}.fields{grid-template-columns:1fr}aside{width:100%}.pair{gap:6px}.wrap{padding:17px 12px 35px}h1{font-size:40px}article{padding:18px}.navrow{display:inline-block;width:50%;vertical-align:top}.mast{padding:12px}.note{margin:8px 0}}
</style><header class="mast"><span class="mark">V</span> Vitrine Vidéo <span style="font-weight:400">/ Commerce T2</span></header><main class="wrap"><div class="k">Atelier de prise · Maquette à valider</div><h1>Nouvel arrivage</h1><p>Un article. Quatre prises. Du premier regard à l’envie de commander.</p><div class="layout"><article id="card"></article><aside><div class="k">Sommaire de visite</div><h3>Explorer sans saisir</h3><small>A · Guide &nbsp; B · Enregistrement &nbsp; C · Vérification</small><div class="actions"><button onclick="go(-1)">Les six questions</button></div><div id="nav"></div></aside></div></main><script>
const Q=__QUESTIONS__,S=__SCREENS__.ecrans,card=document.querySelector('#card'),names=['Le nouvel article','Les détails','En utilisation','Présentation finale'];let idx=-1,flow=false,values={},files=Array(4).fill(''),seen=Array(4).fill(false),ok=Array(4).fill(false),tick=0;const esc=s=>String(s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));const btn=(txt,fn,cls='')=>`<button class="${cls}" onclick="${fn}">${txt}</button>`;function nav(){document.querySelector('#nav').innerHTML=names.map((n,i)=>`<div class="navrow"><strong>${i+1} · ${n}</strong><small>${S[3*i].duree_proposee_s} secondes</small>${['A','B','C'].map((k,j)=>btn(k,`go(${3*i+j})`,idx==3*i+j?'active':'')).join('')}</div>`).join('')}
function go(i){window.t2job=null;flow=false;draw(i)}function draw(i){clearInterval(tick);idx=i;nav();if(i<0){card.innerHTML=`<div class="k">Avant la scène 1</div><h2>Prépare ta publicité</h2><p class="muted">Nouvel arrivage · Six réponses sur un seul article.</p><div class="note">Les exemples sont des indications, pas des réponses. Pour le prix, écris le montant avec ta devise.</div><form id="f"><div class="fields">${Q.champs.map((q,j)=>`<label>${j+1}. ${esc(q.question)}<input required name="${q.cle}" ${q.cle==='whatsapp'?'type="tel"':''} placeholder="Ex. : ${esc(q.exemple)}" value="${esc(values[q.cle]||'')}"></label>`).join('')}</div><div class="actions"><button class="primary">Commencer le parcours →</button>${'<button type="button" onclick="go(0)">Voir les 12 écrans sans répondre</button>'}</div></form><small>Essai local : rien n’est envoyé. Pas d’accès caméra ou microphone.</small>`;const f=document.querySelector('#f');f.oninput=e=>{values[e.target.name]=e.target.value;e.target.setCustomValidity('')};f.onsubmit=e=>{e.preventDefault();for(const q of Q.champs){const el=f.elements[q.cle];if(!el.value.trim()||(q.cle==='whatsapp'&&!/^\+?\d{7,15}$/.test(el.value.replace(/[\s()-]/g,'')))){el.setCustomValidity(q.cle==='whatsapp'?'Entre un numéro, pas le masque d’exemple.':'Réponse obligatoire.');el.reportValidity();return}}flow=true;ok.fill(false);seen.fill(false);draw(0)};return}
const n=Math.floor(i/3),s=S[i],d=s.duree_proposee_s;let top=`<div class="k">${flow?'Parcours d’essai':'Visite libre'} · Écran ${String(i+1).padStart(2,'0')}/12</div><div class="stage"><span class="badge">Scène ${n+1}/4 · ${s.etat} / ${{A:'Guide',B:'Enregistrement',C:'Vérification'}[s.etat]}</span> <small>${d} s proposées</small></div>`;const block=b=>`<div class="box"><h3>${esc(b.label)}</h3><p>${esc(b.texte)}</p></div>`;
if(s.etat==='A'){const b=s.blocs;card.innerHTML=top+`<h2>${esc(s.titre)}</h2><h3>${esc(b[0].label)}</h3><p>${esc(b[0].texte)}</p><div class="pair">${[1,2].map(z=>`<div class="box"><h3>${b[z].label}</h3><ul>${b[z].texte.split(' ; ').map(t=>`<li>${esc(t)}</li>`).join('')}</ul></div>`).join('')}</div>${b.slice(3).map(block).join('')}<div class="actions">${btn(s.boutons[0]+' →',`start(${i+1})`,'primary')}</div><small>Simulation du chronomètre, sans enregistrement réel.</small>`;return}
const img=`<svg viewBox="0 0 400 200" aria-label="Illustration de sac, pas une capture caméra"><rect width="400" height="200" fill="#e5cfb4"/><ellipse cx="200" cy="174" rx="90" ry="9" fill="#c7ac88"/><g transform="translate(200,106) scale(${[1,1.55,1.18,.98][n]})"><path d="M-27,-32v-10a27,27 0 0 1 54,0v10" fill="none" stroke="#583a2c" stroke-width="7"/><path d="M-54,-33h108l12,88H-66z" fill="#a45635" stroke="#6e3b2b" stroke-width="3"/><path d="M-55,-29q54,69 110,0" fill="#bd714b" stroke="#794631" stroke-width="2"/><rect x="-7" y="-3" width="14" height="11" rx="4" fill="#e8bd68"/></g></svg>`;
if(s.etat==='B'){card.innerHTML=top+`<h2>${esc(s.consigne)}</h2><div class="player">${img}<span class="stamp">● REC · simulation</span><span class="clock" id="tm">00:${String(d).padStart(2,'0')}</span></div><progress id="bar" value="0" max="${d}"></progress><small>Illustration · Le compte à rebours passe automatiquement à la vérification.</small>`;let sec=d;tick=setInterval(()=>{sec--;document.querySelector('#tm').textContent='00:'+String(sec).padStart(2,'0');document.querySelector('#bar').value=d-sec;if(!sec)draw(i+1)},1000);return}
card.innerHTML=top+`<h2>${s.titre}</h2><p>${s.consigne}</p><div class="player">${files[n]?'<video controls playsinline src="'+files[n]+'"></video>':img}</div><details><summary>Essayer la relecture avec une vidéo personnelle</summary><input type="file" accept="video/*" id="upload"><small>Lecture locale uniquement. Aucun fichier envoyé.</small></details><div class="actions">${btn(s.boutons[0],`replay(${n})`)}${btn(s.boutons[1],`redo(${n})`)}</div><p id="notice" role="status" class="muted"></p><label><input class="inline" type="checkbox" id="inspect" ${seen[n]?'checked':''}>J’ai vérifié ${files[n]?'ma prise':'cet écran de démonstration'}.</label><div class="actions" id="next"></div>`;let check=document.querySelector('#inspect');function gate(){const allow=seen[n]&&(n!==3||!flow||ok.slice(0,3).every(Boolean));document.querySelector('#next').innerHTML=allow?btn(s.boutons[2]+(n===3?'':' →'),`acceptTake(${n})`,'primary'):''}check.onchange=()=>{seen[n]=check.checked;gate()};gate();document.querySelector('#upload').onchange=e=>{let f=e.target.files[0];if(f){if(files[n])URL.revokeObjectURL(files[n]);files[n]=URL.createObjectURL(f);seen[n]=false;ok[n]=false;draw(i)}}}
function replay(n){const v=card.querySelector('video');if(v){v.muted=false;v.currentTime=0;v.play().catch(()=>document.querySelector('#notice').textContent='Utilise les contrôles du lecteur.')}else document.querySelector('#notice').textContent='Aucun son dans l’illustration. Choisis une vidéo locale pour la relire avec son.'}
function start(i){seen[i/3|0]=false;draw(i)}function redo(n){ok[n]=seen[n]=false;if(files[n])URL.revokeObjectURL(files[n]);files[n]='';draw(n*3)}async function acceptTake(n){if(!seen[n])return;ok[n]=true;if(n<3){draw((n+1)*3);return}if(flow&&!ok.every(Boolean))return;
window.t2job=null;
if(flow&&files.every(Boolean)){
 const captures=await Promise.all(files.map(async (url,j)=>{const bytes=await (await fetch(url)).arrayBuffer();const hash=await crypto.subtle.digest('SHA-256',bytes);return {scene:'S'+(j+1),sha256:Array.from(new Uint8Array(hash),b=>b.toString(16).padStart(2,'0')).join(''),valide:true}}));
 window.t2job={template_id:'COMMERCE-T2',reponses:{...values},captures};
}
card.innerHTML=`<div class="k">Fin de la ${flow?'simulation':'visite'}</div><h2>${flow?'Aperçu des réponses':'Les 12 écrans'}</h2><p>${flow?'Les quatre scènes ont été vérifiées.':'Le parcours réel demandera les six réponses et quatre prises vérifiées.'} Aucun MP4 n’est généré par cette maquette.</p>${flow?Q.champs.map(q=>`<div class="box"><strong>${esc(q.question)}</strong><p>${esc(values[q.cle])}</p></div>`).join(''):''}<div class="actions">${btn('Revenir aux questions','go(-1)')}</div>`}draw(-1);
</script></html>
